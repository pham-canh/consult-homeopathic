# Copy to .env (gitignored). Fill in ONE provider below; the app picks the first
# provider with a key, or set INFERENCE_PROVIDER explicitly.
#
# No model id is hard-coded. Put whichever model id your key can use.
# Supported: vultr (default for the event), openai (ChatGPT),
#            anthropic (Claude), gemini (Google), openai-compatible.
#
# INFERENCE_PROVIDER=vultr

# --- Vultr Serverless Inference (required for the submitted demo) ------------
# Free model list: curl https://api.vultrinference.com/v1/models
VULTR_API_KEY=
VULTR_MODEL=

# --- OpenAI / ChatGPT ---------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Anthropic / Claude -------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Google / Gemini ----------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=

# --- Any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, ...) ----------
# INFERENCE_PROVIDER=openai-compatible
# INFERENCE_BASE_URL=https://your-host/v1
# INFERENCE_API_KEY=
# INFERENCE_MODEL=

# Local state: SQLite database, simulated mailbox, and emailed files.
CONSULT_DATA_DIR=out

# 1 = deterministic rule engine only (tests / offline demo).
CONSULT_FAKE_LLM=0

# Optional real email delivery. Without SMTP_HOST the app writes .eml files to
# CONSULT_DATA_DIR/emails and records mode=file in the audit trail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=clinic@example.test
# SMTP_STARTTLS=1
