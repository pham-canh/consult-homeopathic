# Easiest: python3 scripts/configure_model.py
# It asks for a provider, model, and key, then writes this gitignored file.
#
# Or copy to .env and fill in ONE provider below; the app uses the provider named
# in INFERENCE_PROVIDER, or the first provider with a key.
#
# No model id is hard-coded. Put whichever model id your key can use.
# Supported: vultr (default for the event), openai (ChatGPT),
#            anthropic (Claude), gemini (Google), openai-compatible.
# Aliases: chatgpt, claude, google, openrouter, ollama, custom.
#
# INFERENCE_PROVIDER=vultr

# --- Vultr Serverless Inference ---------------------------------------------
# Free model list: curl https://api.vultrinference.com/v1/models
VULTR_API_KEY=
VULTR_MODEL=

# --- OpenAI / ChatGPT -------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Anthropic / Claude -----------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- Google / Gemini --------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=

# --- Any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, ...) ---------
# INFERENCE_PROVIDER=openai-compatible
# INFERENCE_BASE_URL=https://your-host/v1
# INFERENCE_API_KEY=
# INFERENCE_MODEL=

# Local state: SQLite database, uploaded reports, and simulated mailbox.
CONSULT_DATA_DIR=out

# 1 = deterministic rule engine only (tests / offline demo).
CONSULT_FAKE_LLM=0

# Public base URL used in emailed follow-up links.
CONSULT_PUBLIC_URL=http://127.0.0.1:8000

# Follow-up agent: days after approval, and how often the scheduler looks for
# due check-ins. Set FOLLOWUP_DAYS=0 for an immediate demo.
FOLLOWUP_DAYS=2
FOLLOWUP_POLL_SECONDS=60
# 1 = do not start the background scheduler (tests).
# CONSULT_DISABLE_SCHEDULER=1

# Optional: where escalation alerts go. Without it, escalations still appear on
# the doctor dashboard and in the audit trail.
# CONSULT_DOCTOR_EMAIL=doctor@example.test

# Optional real email delivery. Without SMTP_HOST the app writes .eml files to
# CONSULT_DATA_DIR/emails and records mode=file in the audit trail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=clinic@example.test
# SMTP_STARTTLS=1
