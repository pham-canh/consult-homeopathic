# Copy to .env (gitignored). Do not commit real keys.
# Vultr Serverless Inference is the provider for the submitted demo.
INFERENCE_PROVIDER=vultr
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
INFERENCE_MODEL=
INFERENCE_API_KEY=

# Local state: SQLite database, simulated mailbox, and emailed files.
CONSULT_DATA_DIR=out

# Set to 1 only for tests or an offline demo. The UI labels rule-engine replies.
CONSULT_FAKE_LLM=0

# Optional real email delivery. Without SMTP_HOST the app writes .eml files to
# CONSULT_DATA_DIR/emails and records mode=file in the audit trail.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=clinic@example.test
# SMTP_STARTTLS=1
